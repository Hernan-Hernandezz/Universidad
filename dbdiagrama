// ---- MÓDULO DE USUARIOS Y BIENESTAR ----

Table Estudiantes {
  id_estudiante int [pk, increment]
  nombre varchar
  correo_institucional varchar [unique]
  contrasena_hash varchar
}

Table Docentes {
  id_docente int [pk, increment]
  nombre varchar
  correo varchar
  contrasena_hash varchar
}



// ---- MÓDULO ACADÉMICO Y HORARIOS ----

Table Aulas {
  id_aula int [pk, increment]
  numero_bloque int
  numero_salon int
}

Table Asignaturas {
  id_asignatura int [pk, increment]
  nombre_materia varchar
}


Table Inscripciones {
  id_inscripcion int [pk, increment]
  id_estudiante int [ref: > Estudiantes.id_estudiante]
  id_asignatura int [ref: > Asignaturas.id_asignatura]
  periodo_academico varchar // Ej: "2026-1"
  nota float
  id_clase_horario int [ref:> Clases_Horario.id_clase_horario]
  //id_tareas int [ref: < Tareas.id_tarea]
}

Table clase {
  id_clase int [pk]
  //id_inscripcion int [ref:> Inscripciones.id_inscripcion]
  id_clase_horario int [ref: > Clases_Horario.id_clase_horario]
  id_asignatura int [ref: <> Asignaturas.id_asignatura]

}

Table Clases_Horario {
  id_clase_horario int [pk, increment]
  //id_asignatura int [ref: <> Asignaturas.id_asignatura]
  id_aula int [ref: > Aulas.id_aula]
  dia_semana varchar // Lunes, Martes, etc.
  hora_inicio time
  hora_fin time
}


// ---- MÓDULO DE EVALUACIONES Y ALERTAS ----



Table Tareas {
  id_tarea int [pk, increment]
  id_inscripciones int  [ref: > Inscripciones.id_inscripcion]
  titulo_tarea varchar
  descripcion text
  fecha_entrega datetime
  estado text
  nota float
  porcentaje_asignatura int
}


Table Alertas {
  id_alerta int [pk, increment]
  id_estudiante int [null, ref: <> Estudiantes.id_estudiante] // Null si es un anuncio global
  titulo varchar
  mensaje text
  fecha_creacion datetime
  fecha_fin datetime
  prioridad varchar // Alta, Media, Baja
}

Table DocenteAsignatura{
  id_docente_asignatura int [pk, increment]
  id_docente int [ref: > Docentes.id_docente]
  id_asignatura int [ref: > Asignaturas.id_asignatura]

}
